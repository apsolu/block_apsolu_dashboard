{{!
 @template blocks/apsolu_dashboard/ical_export_modal

    Template Moodle pour afficher une modal permettant d'export le calendrier APSOLU au format ical.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * link - string - l'URL d'export (format .ical)

    Example context (json):
    {
        "string": ""
    }
}}
<div>
    <div>
        <div class="my-2">
            <p class="my-2">Utilisez l'URL ci-dessous pour synchroniser votre planning d'activités dans votre agenda numérique (Partage, Thunderbird, Google, iOS et autres).</p>
           <div class="apsolu-ical mt-3">
                <div class="input-group">
                    <input id='apsolu-ical-link-input'
                    type="text"
                    class="form-control-sm apsolu-ical-link bg-light px-2"
                    value="{{{wwwical}}}"
                    readonly
                    onclick="this.select();">
                    <div class="input-group-append">
                        <button type="button"
                                class="btn btn-outline-secondary apsolu-ical-link-copy"
                                data-value="{{wwwical}}"
                                title="{{#str}} copy, local_apsolu {{/str}}"
                                aria-label="{{#str}} copy, local_apsolu {{/str}}">
                            <i class="fa fa-copy" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div id="modal-info" class="my-2">
            <i class="fa-solid fa-circle-info me-3"></i>
            <a href="#" data-action="show-ical-help">Comment importer dans Partage ?</a>
        </div>
    </div>
</div>
